# Git 属性：统一换行、标记二进制
#
# 目的
# ----
# 仓库在 Windows 上开发，但协作 / CI 也会在 Linux 侧做文本处理（文档渲染、脚本检查）。
# 若换行符按平台自动变化，diff 会出现整文件改动的噪音，也会让 .exe / .pdf 这类二进制
# 被误当成文本处理。这里显式声明：文本一律 LF，二进制一律不做转换。

# 默认：让 Git 自动识别文本文件，检出时统一用 LF
* text=auto eol=lf

# 明确按文本处理、强制 LF 的类型（补一手，避免自动识别失灵）
*.py       text eol=lf
*.pyi      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.toml     text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.iss      text eol=lf
*.ps1      text eol=lf
*.spec     text eol=lf
*.rs       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.svg      text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Windows 批处理保留 CRLF（cmd.exe 对 LF 行尾的 label/goto 处理不可靠）
*.cmd      text eol=crlf
*.bat      text eol=crlf

# 二进制：禁止换行转换与文本 diff
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.icns     binary
*.pdf      binary
*.note     binary
*.annot    binary
*.exe      binary
*.dll      binary
*.pyd      binary
*.so       binary
*.whl      binary
*.zip      binary
*.7z       binary
*.ttf      binary
*.otf      binary
